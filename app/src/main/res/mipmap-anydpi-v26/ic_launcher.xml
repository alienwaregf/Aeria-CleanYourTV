<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon (v5): the approved v4 artwork split into layers. The background is the
     full-bleed teal-to-indigo gradient and the foreground is the thin white TV outline; the
     system masks both to its shape, so the white tile the v4 legacy icon showed in the app list
     (a stale cached icon rendered as a legacy icon) cannot come back from the artwork itself.
     The five legacy mipmap PNGs stay as the fallback below API 26. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
